# Copy to .env and fill in. Bun and the dev shell both load .env automatically.

# Bot User OAuth Token, from the app's "OAuth & Permissions" page
# (`slack app settings` opens the app's settings).
SLACK_BOT_TOKEN=xoxb-your-token

# ID of the channel to post to (not its name). In Slack, open the channel's
# details; the ID is at the bottom of the "About" tab.
SLACK_CHANNEL_ID=C0123456789

# The SQLite database of scraped listings and posted jobs.
# JOBBO_DB_PATH=jobbo.sqlite

# Most Slack messages to send per run; the rest wait for the next run.
# JOBBO_MAX_POSTS_PER_RUN=40

# Never post jobs posted before this day. Defaults to the day of the first run.
# JOBBO_POST_SINCE=2026-09-24

# Set to 1 to also post jobs whose only locations are outside the US. They are
# always scraped and stored.
# JOBBO_POST_INTERNATIONAL=0

# Log lines are also appended to this file. Set it empty to log to the terminal only.
# JOBBO_LOG_FILE=jobbo.log
