{
  "display_information": {
    "name": "Jobbo",
    "description": "Posts new job postings to a channel",
    "background_color": "#1d4ed8"
  },
  "features": {
    "bot_user": {
      "display_name": "Jobbo",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
